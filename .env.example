# Catalog API base URL — points at the Kong API gateway, the single entry point for
# the system. Kong routes /games, /orders and /library to the Catalog and validates the
# JWT before forwarding, so a request without a token gets a 401 from the gateway.
#
# The same address works in both environments (see FiapGames.Orchestration's README):
#   Docker Compose:    the `kong` service publishes 8000 on the host
#   Kubernetes (kind): k8s/kind-config.yaml publishes kong's NodePort on 8000
#
# CORS is still answered by the APIs themselves (allowing http://localhost:5173) — the
# gateway deliberately adds no cors plugin, which would duplicate the headers.
# In production, set this to the deployed gateway's base URL, e.g. https://api.fiapgames.com
VITE_API_BASE_URL=http://localhost:8000

# Same idea for the Users API. Because the gateway collapses everything onto one origin
# this is the same value as above — Kong tells them apart by path (/api/users).
VITE_USERS_API_BASE_URL=http://localhost:8000
