# Leave empty in dev: requests go through the Vite proxy configured in vite.config.ts,
# which forwards to http://localhost:8085 and avoids CORS (the Catalog API has none configured).
# In production, set this to the deployed Catalog API's base URL, e.g. https://api.fiapgames.com
VITE_API_BASE_URL=

# Same idea, but for the separate Users API (dev proxy forwards to http://localhost:8083).
# In production, set this to the deployed Users API's base URL.
VITE_USERS_API_BASE_URL=
