# Catalog API base URL. Called directly (no dev proxy) — the API has a CORS policy
# allowing http://localhost:5173. Docker Compose: http://localhost:8080.
# Kubernetes (kind): `kubectl port-forward -n fiapgames svc/catalog-api 8090:80` (see
# FiapGames.Orchestration's README — 8090/8091 avoid colliding with docker-compose's 8080/8083).
# In production, set this to the deployed Catalog API's base URL, e.g. https://api.fiapgames.com
VITE_API_BASE_URL=http://localhost:8090

# Same idea, but for the separate Users API. Docker Compose: http://localhost:8083.
# Kubernetes (kind): `kubectl port-forward -n fiapgames svc/user-api 8091:80`.
# In production, set this to the deployed Users API's base URL.
VITE_USERS_API_BASE_URL=http://localhost:8091
